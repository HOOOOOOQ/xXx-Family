# =====================================================================
# xXx Family — Environment configuration
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# NEVER commit the real .env file. It is ignored by Git.
# =====================================================================

# --- Discord application credentials (Discord Developer Portal) -------
# Bot -> Token
DISCORD_TOKEN=
# General Information -> Application ID
DISCORD_CLIENT_ID=
# OAuth2 -> Client secret
DISCORD_CLIENT_SECRET=
# OAuth2 -> Redirect (must EXACTLY match the value registered in the portal)
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional: deploy slash commands instantly to one guild while developing.
# Leave empty to register globally (takes up to 1 hour to propagate).
DEPLOY_GUILD_ID=

# --- Database (MongoDB Atlas — no local MongoDB server required) ------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/xxxfamily?retryWrites=true&w=majority

# --- Web / API --------------------------------------------------------
# 64+ random chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Public URL of the Next.js dashboard
DASHBOARD_URL=http://localhost:3000
# Public URL of the Express API
API_BASE_URL=http://localhost:4000
PORT=4000
# development | production | test
NODE_ENV=development

# --- Internationalization --------------------------------------------
# One of: en-US, en-GB, id-ID, es-ES, pt-BR, fr-FR, de-DE, ja-JP, ko-KR, ar
DEFAULT_LANGUAGE=en-US
# Comma separated list of locales to load. Empty = load every locale shipped in src/locales
ENABLED_LOCALES=

# --- AI assistant (Phase 6) ------------------------------------------
AI_PROVIDER=
AI_API_KEY=

# --- Runtime tuning ---------------------------------------------------
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=pretty
# Extra guild ids (comma separated) allowed to use owner-only commands
OWNER_IDS=
# Comma separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
